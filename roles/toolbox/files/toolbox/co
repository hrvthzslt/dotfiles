#!/bin/sh
# Docker compose wrapper

help() {
  echo "Usage: co [u|r|l|h] (or any docker compose command)"
  echo "  u     up -d"
  echo "  r     restart [services]"
  echo "  l     logs -f [services]"
  echo "  h     help"
  exit 1
}

get_command() {
  if docker compose >/dev/null 2>&1; then
    echo "docker compose"
    return
  fi

  if docker-compose >/dev/null 2>&1; then
    echo "docker-compose"
    return
  fi

  exit 1
}

up() {
  $(get_command) up -d --remove-orphans
}

restart() {
  $(get_command) restart "$@"
}

logs() {
  $(get_command) logs -f "$@"
}

pass_through() {
  $(get_command) "$@"
}

main() {
  case $1 in
    u)
      up
      ;;
    r)
      shift
      restart "$@"
      ;;
    l)
      shift
      logs "$@"
      ;;
    --help | -h | h)
      help
      ;;
    *)
      pass_through "$@"
      ;;
  esac
}

main "$@"
